<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>object_tracking</name>
  <version>0.0.0</version>
  <description>
    Kalman-filter tracking of the moving target box on the conveyor.
    Subscribes vision detections (assembly_interfaces/DetectedObject, type=="target")
    and publishes the predicted target pose (assembly_interfaces/PredictedTarget).
  </description>
  <maintainer email="maymayko9559@gmail.com">may</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>assembly_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
